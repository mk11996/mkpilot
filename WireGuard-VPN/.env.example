# Public IP address or a DNS name that resolves to this server.
# It may share the same hostname as the openpilot web site: UDP 51820 does not
# conflict with the website's TCP 80/443 ports.
WG_ENDPOINT=www.39love.net
WG_PORT=51820

# On the server run: id -u ; id -g
PUID=1000
PGID=1000

# Comma-separated client names. Do not use spaces or Chinese characters here.
WG_PEERS=phone,laptop

# Full-tunnel DNS and tunnel subnet. The default subnet does not overlap with
# the user's home 192.168.x.x LAN.
WG_DNS=1.1.1.1
WG_SUBNET=10.13.13.0
WG_ALLOWED_IPS=0.0.0.0/0,::/0
TZ=Asia/Shanghai
