APP_NAME=openpilot-local-server
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-db-password
DATABASE_URL=postgresql+psycopg://openpilot:replace-db-password@postgres:5432/openpilot
STORAGE_ROOT=/srv/openpilot-storage
UPLOAD_TOKEN_TTL_SECONDS=900
MAX_UPLOAD_BYTES=2147483648
FFMPEG_ENABLED=1
VIDEO_FPS=20
LOCAL_ENROLL_CODE=change-this-one-time-enrollment-code
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
APP_TOKEN_TTL_SECONDS=86400
JWT_CLOCK_SKEW_SECONDS=5
DIAGNOSTICS_TOKEN=change-this-diagnostics-token
LOG_LEVEL=INFO
SERVER_DOMAIN=localhost
API_PORT=18080
HTTP_PORT=8081
HTTPS_PORT=8443
ATHENA_PATH_PREFIX=/ws/v2
PUBLIC_BASE_URL=http://192.168.5.3:18080
